<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="realsense_camera">
    <static>true</static>

    <link name="realsense_link">
      <inertial>
        <mass>0.0615752</mass>
        <inertia>
          <ixx>9.108e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.51e-06</iyy><iyz>0</iyz>
          <izz>8.931e-05</izz>
        </inertia>
      </inertial>

      <collision name="realsense_link_collision">
        <pose>-0.012 0 0 0 0 1.5708</pose>
        <geometry>
          <mesh><uri>model://realsense_camera/meshes/realsense.dae</uri></mesh>
        </geometry>
      </collision>

      <visual name="realsense_link_visual">
        <pose>0 0 0 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://realsense_camera/meshes/realsense.dae</uri>
            <submesh>
              <name>RealSense</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- RGB + depth + point cloud in one sensor (Harmonic "rgbd_camera").
           gz topics (bridged to the old ROS names in config/gz_bridge.yaml):
             /realsense/depth/image         RGB image
             /realsense/depth/depth_image   32FC1 depth
             /realsense/depth/points        PointCloud2
             /realsense/depth/camera_info -->
      <sensor name="cameradepth" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>realsense/depth</topic>
        <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
        <camera name="depth_camera">
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
