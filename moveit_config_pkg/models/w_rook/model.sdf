<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="w_rook">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0.0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://w_rook/w_rook.stl</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Collision Box scaled per piece height -->
      <collision name="collision">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.025 0.070</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
